<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Contact Book - Web Form</title>
    <style>
        body { font-family: sans-serif; background: #eee; padding: 20px; }
        .window { background: white; max-width: 700px; margin: auto; padding: 20px; border: 1px solid #ccc; box-shadow: 2px 2px 10px rgba(0,0,0,0.1); }
        h1 { text-align: center; color: #006699; font-style: italic; }
        
        .row { display: flex; gap: 10px; margin-bottom: 10px; align-items: center; }
        .label { width: 100px; font-weight: bold; color: #003366; text-align: right; margin-right: 10px;}
        .input-field { flex: 1; padding: 5px; }
        .alert { padding: 10px; text-align: center; margin-bottom: 15px; background: #d1ecf1; color: #0c5460; border-radius: 4px; }
        
        .btn-panel { display: flex; justify-content: center; gap: 15px; margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee; }
        button { padding: 10px 20px; cursor: pointer; font-weight: bold; color: white; border: none; border-radius: 4px; }
        .btn-save { background: #003399; }
        .btn-search { background: #003399; }
        .btn-update { background: #003399; }
        .btn-delete { background: #003399; }
        .btn-new { background: #003399; }
        
        input[readonly] { background: #e9ecef; border: 1px solid #ced4da; }
    </style>
</head>
<body>

<div class="window">
    <h1>CONTACTS BOOK</h1>

    <% if (message) { %>
        <div class="alert"><%= message %></div>
    <% } %>

    <form method="POST">
        
        <div class="row">
            <span class="label">ID:</span>
            <input type="text" name="id" class="input-field" 
                   value="<%= contact ? contact.id : '' %>" 
                   <%= isEditing ? 'readonly' : '' %>>
        </div>

        <div class="row">
            <span class="label">First Name:</span>
            <input type="text" name="firstName" class="input-field" 
                   value="<%= contact ? contact.firstName : '' %>">
        </div>
        <div class="row">
            <span class="label">Last Name:</span>
            <input type="text" name="lastName" class="input-field" 
                   value="<%= contact ? contact.lastName : '' %>">
        </div>

        <div class="row">
            <span class="label">Birth Day:</span>
            <% 
               let dateVal = '';
               if (contact && contact.birthDate) {
                   if (contact.birthDate instanceof Date) {
                       dateVal = contact.birthDate.toISOString().split('T')[0];
                   } else {
                       dateVal = contact.birthDate;
                   }
               }
            %>
            <input type="date" name="birthDate" class="input-field" value="<%= dateVal %>">
            
            <span class="label" style="width: 50px;">Age:</span>
            <input type="text" class="input-field" readonly style="width: 50px; flex:none;"
                   value="<%= contact ? contact.age : '' %>">
        </div>

        <div class="row">
            <span class="label">Type:</span>
            <select name="typeOfContact" class="input-field">
                <option value="Select">Select</option>
                <option value="Family" <%= (contact && contact.typeOfContact == 'Family') ? 'selected' : '' %>>Family</option>
                <option value="Friend" <%= (contact && contact.typeOfContact == 'Friend') ? 'selected' : '' %>>Friend</option>
                <option value="Job" <%= (contact && contact.typeOfContact == 'Job') ? 'selected' : '' %>>Job</option>
                <option value="Unknown" <%= (contact && contact.typeOfContact == 'Unknown') ? 'selected' : '' %>>Unknown</option>
            </select>
        </div>

        <div class="row">
            <span class="label">Sex:</span>
            <div class="input-field">
                <input type="radio" name="sex" value="Male" <%= (contact && contact.sex == 'Male') ? 'checked' : '' %>> Male
                <input type="radio" name="sex" value="Female" <%= (contact && contact.sex == 'Female') ? 'checked' : '' %>> Female
            </div>
        </div>

        <div class="row" style="align-items: flex-start;">
            <span class="label">Hobbies:</span>
            <div class="input-field">
                <% let h = (contact && contact.hobbies) ? contact.hobbies : []; %>
                <label><input type="checkbox" name="hobbies" value="Soccer" <%= h.includes('Soccer') ? 'checked' : '' %>> Soccer</label>
                <label><input type="checkbox" name="hobbies" value="Read" <%= h.includes('Read') ? 'checked' : '' %>> Read</label>
                <label><input type="checkbox" name="hobbies" value="Cook" <%= h.includes('Cook') ? 'checked' : '' %>> Cook</label><br>
                <label><input type="checkbox" name="hobbies" value="Sing" <%= h.includes('Sing') ? 'checked' : '' %>> Sing</label>
                <label><input type="checkbox" name="hobbies" value="Swim" <%= h.includes('Swim') ? 'checked' : '' %>> Swim</label>
                <label><input type="checkbox" name="hobbies" value="Djing" <%= h.includes('Djing') ? 'checked' : '' %>> Djing</label>
                <label><input type="checkbox" name="hobbies" value="Play an instrument" <%= h.includes('Play an instrument') ? 'checked' : '' %>> Play an instrument</label>
            </div>
        </div>

        <div class="row">
            <span class="label">Comments:</span>
            <textarea name="comments" class="input-field" rows="3"><%= contact ? contact.comments : '' %></textarea>
        </div>

        <div class="btn-panel">
            
            <button type="submit" formaction="/reset" class="btn-new" formnovalidate>NEW</button>

            <% if (isEditing) { %>
                <button type="submit" formaction="/update" class="btn-update">UPDATE</button>
                <button type="submit" formaction="/delete" class="btn-delete" onclick="return confirm('Are you sure you want to delete this contact?');">DELETE</button>
            <% } else { %>
                <button type="submit" formaction="/save" class="btn-save">SAVE</button>
                <button type="submit" formaction="/search" class="btn-search" formnovalidate>SEARCH</button>
            <% } %>

        </div>
    </form>
</div>

</body>
</html>