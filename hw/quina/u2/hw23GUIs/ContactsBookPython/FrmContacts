import sys
from PyQt5.QtWidgets import *
from PyQt5.QtCore import Qt
from PyQt5.QtGui import QFont

class FrmContacts(QWidget):
    def __init__(self):
        super().__init__()
        self.setup_ui()

    def setup_ui(self):
        self.setWindowTitle("Contacts")
        self.setGeometry(200, 100, 750, 650)

        main_layout = QVBoxLayout()
        title = QLabel("CONTACTS")
        title.setFont(QFont("Stencil", 28))
        title.setAlignment(Qt.AlignCenter)
        main_layout.addWidget(title)

        form = QGridLayout()

        self.txtId = QLineEdit()
        form.addWidget(QLabel("id:"), 0, 0)
        form.addWidget(self.txtId, 0, 1)

        self.txtFirst = QLineEdit()
        form.addWidget(QLabel("First Name:"), 1, 0)
        form.addWidget(self.txtFirst, 1, 1)

        self.txtComments = QTextEdit()
        form.addWidget(QLabel("Comments"), 1, 2)
        form.addWidget(self.txtComments, 2, 2, 5, 1)

        self.txtLast = QLineEdit()
        form.addWidget(QLabel("Last Name:"), 2, 0)
        form.addWidget(self.txtLast, 2, 1)

        self.txtBirth = QLineEdit()
        self.btnDate = QPushButton("📅")
        birth_layout = QHBoxLayout()
        birth_layout.addWidget(self.txtBirth)
        birth_layout.addWidget(self.btnDate)
        form.addWidget(QLabel("Birth Date:"), 3, 0)
        form.addLayout(birth_layout, 3, 1)

        self.txtAge = QLineEdit()
        form.addWidget(QLabel("Age:"), 4, 0)
        form.addWidget(self.txtAge, 4, 1)

        self.cmbType = QComboBox()
        self.cmbType.addItems(["Family", "Friend", "Classmate", "Work"])
        form.addWidget(QLabel("Type:"), 5, 0)
        form.addWidget(self.cmbType, 5, 1)

        self.rbMale = QRadioButton("Male")
        self.rbFemale = QRadioButton("Female")
        sex_layout = QHBoxLayout()
        sex_layout.addWidget(self.rbMale)
        sex_layout.addWidget(self.rbFemale)
        form.addWidget(QLabel("Sex:"), 6, 0)
        form.addLayout(sex_layout, 6, 1)

        self.listHobbies = QListWidget()
        hobbies = ["PlaySoccer", "Dj-ing", "Read", "Cook", "Swim", "Sing", "Play an instrument"]
        self.listHobbies.addItems(hobbies)
        self.listHobbies.setSelectionMode(QAbstractItemView.MultiSelection)
        self.listHobbies.setFixedHeight(150)
        form.addWidget(QLabel("Hobbies:"), 7, 0)
        form.addWidget(self.listHobbies, 7, 1)

        main_layout.addLayout(form)

        self.btnSave = QPushButton("Save")
        self.btnSave.setFixedWidth(100)
        self.btnSave.setStyleSheet("background-color:#0A1E74; color:white;")
        main_layout.addWidget(self.btnSave, alignment=Qt.AlignCenter)

        self.setLayout(main_layout)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = FrmContacts()
    window.show()
    sys.exit(app.exec_())
