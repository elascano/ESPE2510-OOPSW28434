from abc import ABC, abstractmethod

class SortingAlgorithm(ABC):
    @abstractmethod
    def sort_collection(self, elements: list) -> list:

        pass

class BubbleSortAlgorithm(SortingAlgorithm):
    def sort_collection(self, elements: list) -> list:
        total_elements = len(elements)
        for outer_index in range(total_elements):
            for inner_index in range(0, total_elements - outer_index - 1):
                if elements[inner_index] > elements[inner_index + 1]:
                    elements[inner_index], elements[inner_index + 1] = \
                        elements[inner_index + 1], elements[inner_index]
        return elements

class InsertionSortAlgorithm(SortingAlgorithm):
    def sort_collection(self, elements: list) -> list:
        for current_index in range(1, len(elements)):
            value_to_insert = elements[current_index]
            comparison_index = current_index - 1
            while comparison_index >= 0 and value_to_insert < elements[comparison_index]:
                elements[comparison_index + 1] = elements[comparison_index]
                comparison_index -= 1
            elements[comparison_index + 1] = value_to_insert
        return elements

class QuickSortAlgorithm(SortingAlgorithm):
    def sort_collection(self, elements: list) -> list:
        if len(elements) <= 1:
            return elements
        
        pivot_element = elements[len(elements) // 2]
        smaller_elements = [item for item in elements if item < pivot_element]
        equal_elements = [item for item in elements if item == pivot_element]
        larger_elements = [item for item in elements if item > pivot_element]
        
        return self.sort_collection(smaller_elements) + \
               equal_elements + \
               self.sort_collection(larger_elements)