from pymongo import MongoClient

class SortingResultsRepository:
    def __init__(self, connection_string: str, database_name: str, collection_name: str):
        self.database_client = MongoClient(connection_string)
        self.storage_collection = self.database_client[database_name][collection_name]

    def persist_sorting_operation(self, unsorted_list, list_size, algorithm_used, sorted_list):
        sorting_record = {
            "unsorted": str(unsorted_list),
            "size": list_size,
            "sort algorithm": algorithm_used,
            "sorted": str(sorted_list)
        }
        return self.storage_collection.insert_one(sorting_record)