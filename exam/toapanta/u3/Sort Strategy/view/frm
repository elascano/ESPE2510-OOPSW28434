import tkinter as tk
from tkinter import messagebox

from SortingCoordinator import SortingCoordinator

class SortingApplicationUI(tk.Tk):
    def __init__(self, coordinator: SortingCoordinator):
        super().__init__()
        self.coordinator = coordinator
        self.title("Sistema de Ordenamiento Profesional")
        self._build_interface()

    def _build_interface(self):
        tk.Label(self, text="Ingrese números separados por comas:").pack(pady=5)
        self.input_field = tk.Entry(self, width=50)
        self.input_field.pack(pady=5)
        
        self.process_button = tk.Button(
            self, text="Ejecutar Ordenamiento", command=self._handle_processing_event
        )
        self.process_button.pack(pady=10)
        
        self.display_area = tk.Label(self, text="", justify="left", font=("Consolas", 10))
        self.display_area.pack(pady=20)

    def _handle_processing_event(self):
        try:
            user_data = self.input_field.get()
            report = self.coordinator.process_sorting_request(user_data)
            
            summary_message = (
                f"Algoritmo Utilizado: {report['algorithm']}\n"
                f"Elementos Procesados: {report['count']}\n"
                f"Lista Ordenada: {report['result']}"
            )
            self.display_area.config(text=summary_message)
            messagebox.showinfo("Operación Exitosa", "Datos guardados en MongoDB Atlas")
            
        except Exception as error:
            messagebox.showerror("Error de Procesamiento", str(error))